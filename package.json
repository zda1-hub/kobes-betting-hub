{
  "name": "kobes-betting-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Approval-first Discord publisher for Kobe's Betting Hub",
  "scripts": {
    "build:site": "node scripts/prepare-public-site.mjs",
    "bot": "node bot/index.js",
    "register:commands": "node bot/register-commands.js",
    "collect:x": "node pipeline/collect-x.js",
    "enrich:pick": "node pipeline/enrich-pick.js",
    "trends:espn": "node pipeline/generate-espn-trends.js",
    "test:real-x-pick": "node pipeline/test-real-x-pick.js",
    "prepare:approval": "node pipeline/prepare-approval.js",
    "migrate:audit": "node pipeline/migrate-audit.js",
    "sync:openai-usage": "node scripts/sync-openai-usage.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test": "node --test bot/**/*.test.js pipeline/**/*.test.js cloudflare/*.test.mjs scripts/*.test.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3"
  }
}
