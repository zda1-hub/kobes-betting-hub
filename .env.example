# Create a Discord application and bot at https://discord.com/developers/applications.
# Never commit the real token or share it in chat.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Set to true only for hosted deployments that should register slash commands
# automatically each time the worker starts.
AUTO_REGISTER_COMMANDS=false

# Set this while testing so slash-command updates are immediate. Remove it only
# after registering the commands globally for production.
DISCORD_GUILD_ID=

# The default channel for approved pick posts. A publisher can override this only
# with a channel listed in ALLOWED_CHANNEL_IDS.
PUBLISH_CHANNEL_ID=
# Optional dedicated channel for daily recaps. It must also appear in
# ALLOWED_CHANNEL_IDS when that safety allowlist is configured.
RECAP_CHANNEL_ID=
# Automatic official-pick recap email. Defaults to enabled when the recap email
# queue is configured. It emails Kobe only after every successfully published
# official pick for the previous Pacific operating day has a verified,
# non-pending grade in pick-log.csv. Kobe can then review and post it with
# /publish-recap. The FREE_RECAP_* names are kept for backwards compatibility.
FREE_RECAP_ENABLED=true
FREE_RECAP_CHANNEL_ID=
# The recap checks every five minutes. It can finalize once the daily free-pick
# approval window closes (15:00 Arizona by default) and every official pick has
# an ESPN-verified result. Set this later only if the free-pick window changes.
FREE_RECAP_CLOSE_AT=15:00
FREE_RECAP_INTERVAL_MS=300000
# Uses ESPN final box scores to settle only standard, exact-match free-pick
# props and moneylines. Ambiguous or unsupported markets remain PENDING.
AUTO_GRADE_FREE_PICKS=true
# Kobe or an administrator can run /hub-status for a private plain-English
# health check of monitoring, durable logging, grading, recap, and email.
# Optional Gmail notification queue. The Worker and the same Gmail Apps Script
# must share this secret; see docs/free-recap-email-setup.md.
RECAP_NOTIFICATION_QUEUE_URL=https://bettinghub-publisher.kobedirwin.workers.dev
RECAP_NOTIFICATION_QUEUE_SECRET=
KOBE_RECAP_EMAIL=kobedirwin@gmail.com
# Channel where the admin-only /post-welcome-invite command posts the opt-in
# welcome button for existing members (normally #start-here).
WELCOME_CHANNEL_ID=
# Optional role to notify in the welcome announcement, e.g. the Active Member
# role. The bot must have permission to mention this role in the welcome channel.
WELCOME_ROLE_ID=
# Private staff-only channel where Twitter/X candidates await Kobe's approval.
PICK_APPROVAL_CHANNEL_ID=
ALLOWED_CHANNEL_IDS=
FREE_PICK_CHANNEL_ID=
# Optional Discord-to-X free-pick sync. When true, a successful **Post as Free
# Pick** action immediately sends the exact approved free-pick text to the
# publisher. Paid picks are never sent through this path.
FREE_PICK_X_SYNC_ENABLED=false
FREE_PICK_X_PUBLISH_URL=https://bettinghub-publisher.kobedirwin.workers.dev
FREE_PICK_X_QUEUE_SECRET=
# Website Free Pick sync. Use the same secret as the Worker QUEUE_INGEST_SECRET.
FREE_PICK_SITE_PUBLISH_URL=https://bettinghub-publisher.kobesbettinghub-publisher.workers.dev
FREE_PICK_SITE_PUBLISH_SECRET=
EXCLUSIVES_CHANNEL_ID=
# Local development defaults to trackers/pick-log.csv. On Render, set this to a
# persistent-disk path before any official pick is published, e.g.
# /var/data/pick-log.csv.
PICK_LOG_PATH=
# Managed Postgres audit ledger. Keep AUDIT_DATABASE_REQUIRED=false locally
# until the schema has been migrated and verified. Production must set it to
# true before the database is treated as the operating source of truth. With
# the Supabase session pooler and pg 8.16+, use
# ?uselibpqcompat=true&sslmode=require for encrypted pooler compatibility.
DATABASE_URL=
AUDIT_DATABASE_REQUIRED=false
# Existing publisher URL plus a separate shared secret for the durable Daily Picks queue.
DAILY_PICKS_QUEUE_URL=https://bettinghub-publisher.kobedirwin.workers.dev
DAILY_PICKS_QUEUE_SECRET=
TRENDS_CHANNEL_MAP=football:YOUR_ALL_FOOTBALL_TRENDS_CHANNEL_ID,baseball:YOUR_BASEBALL_TRENDS_CHANNEL_ID
TRENDS_AUTO_PUBLISH_ENABLED=false
TRENDS_DAILY_AT=11:00

# Optional default channels by sport. Values use sport:Discord-channel-ID pairs,
# e.g. basketball:123,football:456. A publisher may still select another
# allowlisted destination during the final approval step.
SPORT_CHANNEL_MAP=

# Comma-separated Discord role IDs authorized to use /preview-pick and /publish-pick.
# Leave blank only for a private test server.
PUBLISHER_ROLE_IDS=

# Twitter/X monitoring: public, approved source accounts only. Use an app bearer
# token—never a source account's password. The live Render worker checks only
# when both this value and the individual source's `enabled` flag are true.
X_BEARER_TOKEN=
X_MONITOR_ENABLED=false
# Durable X cursor/dedupe state. Render should place this on the persistent
# disk; otherwise every deploy can repeat same-day API calls and extractions.
X_MONITORING_ROOT=/var/data/x-monitoring
# Defaults to five minutes. Values below one minute are ignored as a cost guard.
X_MONITOR_INTERVAL_MS=300000
# Optional interval changeover date. The override starts on this Pacific calendar
# date and continues afterward, so it can be configured ahead of time without
# changing an active day's polling cadence. Example: 2026-09-12 / 900000 = 15 minutes.
X_MONITOR_INTERVAL_OVERRIDE_DATE=
X_MONITOR_INTERVAL_OVERRIDE_MS=
# Optional one-time launch gate. Monitoring waits until this exact ISO timestamp.
# Always include the California timezone offset, e.g. 2026-08-27T07:00:00-07:00.
# Leave blank to start as soon as X_MONITOR_ENABLED=true.
X_MONITOR_START_AT=
# Optional one-time cutoff. Monitoring stops at this exact ISO timestamp even
# if it has not yet reached the candidate cap.
X_MONITOR_STOP_AT=
# Optional recurring Arizona-time window for the daily monitor.
X_MONITOR_DAILY_AT=
X_MONITOR_DAILY_STOP_AT=
# Optional one-day override; it automatically expires when the date no longer matches.
X_MONITOR_DAILY_STOP_OVERRIDE_DATE=
X_MONITOR_DAILY_STOP_OVERRIDE_AT=
# Optional one-run cap. Leave blank to process every qualifying post during
# the active monitoring window; it never counts commentary or rejected posts.
X_MONITOR_MAX_CANDIDATES=

# Optional private-pilot target. Leave blank to allow every qualifying pick;
# when set, the bot stops only after this many Kobe-approved free picks have
# actually posted to #daily-free-play. Rejections do not count.
X_MONITOR_MAX_APPROVED_FREE_PICKS=

# Kobe's address is intentionally provided here as a non-secret configuration
# value. Sending approval email needs a separate, authorized mail integration.
KOBE_APPROVAL_EMAIL=kobedirwin@gmail.com

# Required later for independently verified current odds and official results.
# Do not substitute browser scraping or unverified social posts for these.
OPENAI_API_KEY=
# Model used only to read the source post/image into structured fields. It does
# not verify picks or decide what should be published.
OPENAI_PICK_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_PICK_PROMPT_VERSION=source-pick-extraction-v1
OPENAI_PICK_REASONING_EFFORT=none
OPENAI_PICK_MAX_OUTPUT_TOKENS=3000
# Keep high for launch-quality card text. Benchmark low on the same audited
# fixtures before changing this production default.
OPENAI_PICK_IMAGE_DETAIL=high
# These rates are audit metadata for estimating request cost from returned
# usage. Review them against current OpenAI pricing before production changes.
OPENAI_PICK_INPUT_USD_PER_MILLION=0.20
OPENAI_PICK_CACHED_INPUT_USD_PER_MILLION=0.02
OPENAI_PICK_OUTPUT_USD_PER_MILLION=1.20
OPENAI_PRICING_VERSION=gpt-5.6-luna-2026-09-12-list
# Leave false until the API key is saved and a single review-card test is run.
ENRICHMENT_ENABLED=false
# Select this only after choosing and authorizing an odds provider.
ODDS_PROVIDER=
ODDS_PROVIDER_API_KEY=
RESULTS_PROVIDER_API_KEY=
