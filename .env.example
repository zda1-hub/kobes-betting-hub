# Create a Discord application and bot at https://discord.com/developers/applications.
# Never commit the real token or share it in chat.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Set to true only for hosted deployments that should register slash commands
# automatically each time the worker starts.
AUTO_REGISTER_COMMANDS=false

# Set this while testing so slash-command updates are immediate. Remove it only
# after registering the commands globally for production.
DISCORD_GUILD_ID=

# The default channel for approved pick posts. A publisher can override this only
# with a channel listed in ALLOWED_CHANNEL_IDS.
PUBLISH_CHANNEL_ID=
# Optional dedicated channel for daily recaps. It must also appear in
# ALLOWED_CHANNEL_IDS when that safety allowlist is configured.
RECAP_CHANNEL_ID=
# Channel where the admin-only /post-welcome-invite command posts the opt-in
# welcome button for existing members (normally #start-here).
WELCOME_CHANNEL_ID=
# Optional role to notify in the welcome announcement, e.g. the Active Member
# role. The bot must have permission to mention this role in the welcome channel.
WELCOME_ROLE_ID=
# Private staff-only channel where Twitter/X candidates await Kobe's approval.
PICK_APPROVAL_CHANNEL_ID=
ALLOWED_CHANNEL_IDS=
FREE_PICK_CHANNEL_ID=
EXCLUSIVES_CHANNEL_ID=
# Local development defaults to trackers/pick-log.csv. On Render, set this to a
# persistent-disk path before any official pick is published, e.g.
# /var/data/pick-log.csv.
PICK_LOG_PATH=

# Optional default channels by sport. Values use sport:Discord-channel-ID pairs,
# e.g. basketball:123,football:456. A publisher may still select another
# allowlisted destination during the final approval step.
SPORT_CHANNEL_MAP=

# Comma-separated Discord role IDs authorized to use /preview-pick and /publish-pick.
# Leave blank only for a private test server.
PUBLISHER_ROLE_IDS=

# Twitter/X monitoring: public, approved source accounts only. Use an app bearer
# token—never a source account's password. The live Render worker checks only
# when both this value and the individual source's `enabled` flag are true.
X_BEARER_TOKEN=
X_MONITOR_ENABLED=false
# Defaults to five minutes. Values below one minute are ignored as a cost guard.
X_MONITOR_INTERVAL_MS=300000
# Optional one-time launch gate. Monitoring waits until this exact ISO timestamp.
# Always include the California timezone offset, e.g. 2026-08-27T07:00:00-07:00.
# Leave blank to start as soon as X_MONITOR_ENABLED=true.
X_MONITOR_START_AT=
# Optional one-run cap. The bot stops after this many valid private approval
# cards are created; it never counts commentary or rejected X posts.
X_MONITOR_MAX_CANDIDATES=

# Kobe's address is intentionally provided here as a non-secret configuration
# value. Sending approval email needs a separate, authorized mail integration.
KOBE_APPROVAL_EMAIL=kobedirwin@gmail.com

# Required later for independently verified current odds and official results.
# Do not substitute browser scraping or unverified social posts for these.
OPENAI_API_KEY=
# Model used only to read the source post/image into structured fields. It does
# not verify picks or decide what should be published.
OPENAI_PICK_ANALYSIS_MODEL=gpt-5-mini
# Leave false until the API key is saved and a single review-card test is run.
ENRICHMENT_ENABLED=false
# Select this only after choosing and authorizing an odds provider.
ODDS_PROVIDER=
ODDS_PROVIDER_API_KEY=
RESULTS_PROVIDER_API_KEY=
